TRABALHO/                      # Pasta principal de trabalho
├── meu_site/                  # RAIZ DO PROJETO DJANGO
│   ├── __pycache__/           # ⚙️ Código compilado gerado pelo Python (pode ignorar)
│   │   └── utils.cpython-314.pyc
│   │
│   ├── core/                  # 🚀 SUA APLICAÇÃO (Onde codifica as funcionalidades)
│   │   ├── templates/         # 🎨 Pasta destinada ao Front-end
│   │   │   └── template.py    # ⚠️ ALERTA: Arquivos aqui devem ser .html (ex: index.html), não .py!
│   │   ├── models.py          # 📊 Onde você define as tabelas do banco de dados
│   │   └── views.py           # 🧠 A "inteligência": processa os dados e chama o utils.py
│   │
│   ├── meu_site/              # ⚙️ CONFIGURAÇÕES GLOBAIS DO PROJETO
│   │   ├── __pycache__/       # ⚙️ Código compilado (ignorar)
│   │   ├── __init__.py        # 📦 Arquivo vazio que diz ao Python que isso é um pacote
│   │   ├── asgi.py            # 🌐 Ponto de conexão para servidores assíncronos (produção)
│   │   ├── settings.py        # 🛠️ Coração do projeto: configurações de segurança, apps e BD
│   │   ├── urls.py            # 🗺️ O "GPS": mapeia links (como /testar) para as views
│   │   └── wsgi.py            # 🌐 Ponto de conexão para servidores síncronos (produção)
│   │
│   ├── .env                   # 🔒 SEGURANÇA: Suas variáveis de ambiente (a chave AES fica aqui)
│   ├── db.sqlite3             # 🗄️ Banco de dados local padrão do Django
│   ├── manage.py              # 🕹️ O "controle remoto" do projeto (usado no terminal)
│   ├── README                 # 📝 Documentação do seu projeto para outros desenvolvedores
│   └── utils.py               # 🔐 Seu módulo externo (onde colocamos a lógica do Fernet/AES)
│
└── venv/                      # 📦 AMBIENTE VIRTUAL: Guarda o Django e todas as dependências